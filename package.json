{
	"name": "place-view-workspace",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "pnpm --filter webapp dev",
		"dev:web": "pnpm --filter webapp dev",
		"dev:desktop": "pnpm --filter tauri-app tauri dev",
		"dev:ios": "pnpm --filter tauri-app tauri ios dev",
		"check": "pnpm -r --filter '!./admin-tools' run check",
		"lint": "pnpm -r --filter '!./admin-tools' run lint",
		"format": "pnpm -r --filter '!./admin-tools' run format",
		"format:check": "pnpm -r --filter '!./admin-tools' run format:check",
		"test": "pnpm -r --filter '!./admin-tools' run test",
		"build": "pnpm -r --filter '!./admin-tools' run build"
	},
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
