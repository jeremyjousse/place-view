{
	"name": "webapp",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@12.18.0",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "cp ../resources/places.json ./static/. && vite build",
		"build:deno": "ADAPTER=deno vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@deno/svelte-adapter": "^0.2.2",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "^26.6.6",
		"autoprefixer": "^10.6.2",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"svelte": "^5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@place-view/core": "workspace:*",
		"@place-view/ui": "workspace:*",
		"@types/leaflet": "^1.9.22",
		"leaflet": "^1.9.4",
		"lucide-svelte": "^1.0.1"
	}
}
