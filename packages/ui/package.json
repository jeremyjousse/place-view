{
	"name": "@place-view/ui",
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*",
			"default": "./src/*"
		}
	},
	"scripts": {
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "true",
		"build": "true",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@place-view/core": "workspace:*",
		"@types/leaflet": "^1.9.22",
		"leaflet": "^1.9.4",
		"lucide-svelte": "^1.0.1"
	},
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
